# =====================================================================
# Production & Offline Environment Defaults for Enterprise Phonebook
# =====================================================================

# Server Port (default: 4400 in Docker/production, 3000 in dev)
PORT=4400

# Application Environment Mode
NODE_ENV=production

# Standardized Persistent Storage Directory (default: /app/data in Docker, ./data in local dev)
DATA_DIR=/app/data

# System Timezone for local logs and Persian date calculations
TZ=Asia/Tehran

# Safe Admin Password Reset Toggle (default: false to prevent resetting credentials on restart)
RESET_ADMIN_PASSWORD=false

# Session / JWT Secret Fallback (replace in high-security environments)
JWT_SECRET=fallback-production-jwt-secret-replace-me

# Initial Bootstrap Administrator Credentials (used only during first-time initialization)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123
