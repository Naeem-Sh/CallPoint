# =====================================================================
# Production & Offline Environment Defaults for Enterprise Phonebook
# =====================================================================

# Server Port (default: 4400 in Docker/production, 3000 in dev)
PORT=4400

# Application Environment Mode
NODE_ENV=production

# System Timezone for local logs and Persian date calculations
TZ=Asia/Tehran

# Persistent Storage Path (defaults to ./storage or bind-mounted volume)
STORAGE_PATH=./storage

# Default Administrator Credentials (provisioned out of the box):
# Username: admin
# Password: 123

