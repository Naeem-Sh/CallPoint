# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables
.env
.env.*
!.env.example

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Storage runtime artifacts (preserve folders with .gitkeep)
storage/backups/*.zip
storage/imports/*.xlsx
storage/imports/*.xls
storage/imports/*.csv
storage/exports/*.xlsx
storage/exports/*.xls
storage/exports/*.csv
*.tmp.*
*.tmp

# Keep empty storage directories tracked
!storage/backups/.gitkeep
!storage/imports/.gitkeep
!storage/exports/.gitkeep
